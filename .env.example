# Server-side API key is injected by the Vayria :op launch commands.
# Do not put OPENAI_API_KEY or any other secret in this file.
AIVIS_BASE_URL=http://127.0.0.1:10101
AIVIS_SPEED_SCALE=1.15
AIVIS_PITCH_SCALE=0
AIVIS_INTONATION_SCALE=1.0
AIVIS_TEMPO_DYNAMICS_SCALE=1.0
VAYRIA_TTS_BACKEND=cloud-with-fallback
AIVIS_CLOUD_BASE_URL=https://api.aivis-project.com
AIVIS_CLOUD_MODEL_UUID=

# Client and local development settings.
# VITE_ values are embedded in the browser bundle. Do not put secrets here.
VITE_APP_MODE=local
VITE_WORLD_MUTATION_ENABLED=false
VITE_MANIFESTATION_ENABLED=false
# Server-only credentials. Never prefix these with VITE_.
FAL_KEY=
RUNWARE_API_KEY=
VAYRIA_MANIFESTATION_PROVIDER=fal
VAYRIA_MANIFESTATION_MODE=fresh-image
VAYRIA_MANIFESTATION_RESOLUTION=480p
# Explicitly enable paid comparison controls only for measurements.
VAYRIA_MANIFESTATION_BENCHMARK=false
VAYRIA_MANIFESTATION_RUNWARE_ENABLED=false
VITE_API_BASE_URL=/
VITE_AUDIO_PRESET=mild
VITE_AUDIO_ENDPOINT_MS=600
VITE_VOICE_INPUT_TRANSPORT=web-speech
VITE_CLOUD_TTS_STREAM_PLAYBACK_ENABLED=0
# Issue #22 candidate is the default. Set baseline to disable it.
VITE_CARD_DROP_REACTION_MODE=candidate
# VAYRIA_* is canonical. WILDCARD_* remains accepted for existing setups.
VAYRIA_BIND_HOST=127.0.0.1
VAYRIA_PORT=5187
# LLM A/B profiles: nano-implicit, nano-legacy, luna-legacy, luna-prefix, luna-explicit.
VAYRIA_LLM_PROFILE=nano-implicit
# Use fast only for an explicit latency/cost comparison.
VAYRIA_LLM_SERVICE_TIER=standard
# Local runs keep automatic provider fallback and warmup disabled by default.
VAYRIA_LLM_FALLBACK_ENABLED=0
VAYRIA_LLM_CACHE_WARMUP_ENABLED=0
VAYRIA_HTTPS=false
# Optional shared HTTPS settings. Worktree setup uses %USERPROFILE%\.vayria\https.env when it exists.
VAYRIA_HTTPS_CONFIG_FILE=
VAYRIA_HTTPS_CERT_FILE=
VAYRIA_HTTPS_KEY_FILE=
VAYRIA_STT_WS_URL=ws://127.0.0.1:8787/stream

# H3 latency comparison: retain static defaults unless explicitly testing video.
VAYRIA_MANIFESTATION_EXPANSION=balanced
VAYRIA_MANIFESTATION_TRANSPORT=queue
VAYRIA_MANIFESTATION_INPUT=inline
VAYRIA_MANIFESTATION_DELIVERY=stored
# This dated experiment extends the preserved $9.825 balance by at most $5.
VAYRIA_MANIFESTATION_LATENCY_BUDGET=false
