{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vayria-web",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./deploy/placeholder",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "vayria.me", "custom_domain": true }
  ]
}
