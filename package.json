{
  "name": "vayria",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:exhibition": "vite --mode exhibition",
    "build": "tsc -b && vite build",
    "test": "npm run test:performer && npm run test:secret-config && npm run test:playcheck && npm run test:worktree-setup && node --test scripts/stress-test.test.mjs",
    "test:performer": "tsc -p tsconfig.performer-test.json && node scripts/run-performer-tests.mjs",
    "test:secret-config": "tsc -p tsconfig.secret-config-test.json && node scripts/run-secret-config-tests.mjs",
    "test:playcheck": "tsc -p tsconfig.playcheck-test.json && node scripts/run-playcheck-tests.mjs && node --test scripts/playcheck.test.mjs",
    "test:worktree-setup": "pwsh -NoProfile -File .\\scripts\\Test-VayriaWorktreeSetup.ps1",
    "stress": "node scripts/stress-test.mjs",
    "playcheck": "node scripts/playcheck.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aituber-onair/chat": "0.52.0",
    "@pixiv/three-vrm": "^1.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.151.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
