# Optional manual exhibition override.
# Worktree setup generates .env.exhibition.local automatically.
# Keep secrets in .env.local. Vite loads both files for exhibition mode.

VITE_APP_MODE=exhibition
VITE_API_BASE_URL=/
VITE_VOICE_INPUT_TRANSPORT=remote
# VAYRIA_* is canonical. WILDCARD_* remains accepted for existing setups.
VAYRIA_BIND_HOST=0.0.0.0
VAYRIA_PORT=5187
VAYRIA_HTTPS=false
# Set VAYRIA_HTTPS_CONFIG_FILE to the shared HTTPS settings file for iPad access.
VAYRIA_HTTPS_CONFIG_FILE=
# Direct certificate settings remain supported when no shared file is configured.
VAYRIA_HTTPS_CERT_FILE=
VAYRIA_HTTPS_KEY_FILE=
VAYRIA_STT_WS_URL=ws://127.0.0.1:8787/stream
