{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vayria-shared-world-staging",
  "account_id": "7414797104d7aca62f03fbd4faf7e5df",
  "main": "worker/worldWorker.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "services": [{"binding":"WORLD_EXECUTOR","service":"vayria-public-staging","entrypoint":"WorldExecution"}],
  "vars": {"SHARED_CONVERSATION_ENABLED":"false","SHARED_HAND_ENABLED":"false"},
  "migrations": [{"tag": "world-v1", "new_sqlite_classes": ["WorldRoom"]}],
  "observability": {"enabled": false}
}
